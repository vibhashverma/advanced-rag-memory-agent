# ---- LLM (generation) ----
# Providers: openai | anthropic | cohere
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# ---- Embeddings ----
# Providers: openai | cohere
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ---- Cohere (rerank; also embeddings/LLM if selected) ----
COHERE_API_KEY=
RERANK_MODEL=rerank-english-v3.0
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
# Documents scoring below this Cohere relevance score (0..1) are dropped
MIN_RELEVANCE_SCORE=0.1

# ---- Qdrant ----
# Leave QDRANT_URL empty to use local persistent storage at QDRANT_PATH
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant_storage
QDRANT_COLLECTION=rag_children

# ---- Mem0 ----
# MEM0_API_KEY set -> hosted Mem0 platform; empty -> open-source Mem0 with local Qdrant
MEM0_API_KEY=
MEM0_PATH=data/mem0

# ---- Chunking / retrieval ----
CHILD_CHUNK_SIZE=200
PARENT_CHUNK_SIZE=1000
RRF_K=60
DENSE_TOP_K=20
SPARSE_TOP_K=20
DATA_DIR=data
DOCUMENTS_DIR=data/documents
LOG_LEVEL=INFO
